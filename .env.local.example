# Copy this file to .env.local and fill in what you have — all optional.
# Locations and the per-location PurpleAir sensor are managed in the dashboard
# (📍 Locations); the key via the ⚙ Keys button. Saved values override these.

# ---- Seeds the first "default" location on a fresh install ----
LOCATION_NAME="San Francisco, CA"
LOCATION_LAT=37.7749
LOCATION_LON=-122.4194

# ---- PurpleAir (air quality + local temp) — account-wide READ key ----
# Free key: https://develop.purpleair.com  (pick the sensor per location in the UI)
PURPLEAIR_READ_KEY=

# Optional Open-Meteo commercial/customer API key. Leave blank to use the free
# public API. When set, fetches go to customer-*.open-meteo.com with ?apikey=.
OPEN_METEO_API_KEY=

# Optional shared secret so only you can trigger /api/collect from cron.
# If set, callers must pass ?token=THIS_VALUE
COLLECT_TOKEN=

# ---- Deployed instances (Docker / PaaS) ----
# Built-in scheduler: collect every N minutes from the running server, so no
# external cron/launchd is needed. 0 disables it. Defaults to 30 in production and
# off during `next dev`.
COLLECT_INTERVAL_MINUTES=30

# Site-wide password (HTTP Basic Auth). Leave UNSET for private access (Tailscale,
# Cloudflare Access, LAN) — auth is then a no-op. SET it when the instance has a
# public URL, or anyone who finds it can rewrite your keys/locations. Username is
# ignored; only the password matters.
SITE_PASSWORD=
