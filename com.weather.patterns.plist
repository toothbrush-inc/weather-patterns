<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weather.patterns</string>

  <!-- Template: replace __NODE__ with `which node` and __PROJECT_DIR__ with the
       absolute path to this checkout (see README, "Logging history automatically"). -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>scripts/collect.mjs</string>
  </array>

  <!-- Run from the project so settings.json / history.json / forecasts.json resolve. -->
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <!-- Every 30 minutes; also runs once when loaded. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/weather-patterns.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/weather-patterns.err</string>
</dict>
</plist>
